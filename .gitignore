# ==============================================================================
# Diabetic Retinopathy Screening Pipeline - .gitignore
# ==============================================================================

# Environment files & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node / Frontend artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
dist-ssr/
*.local

# Datasets (APTOS 2019, IDRiD, Messidor-2, EyePACS, DDR, etc.)
ml-pipeline/data/raw/*
!ml-pipeline/data/raw/.gitkeep
ml-pipeline/data/processed/*
!ml-pipeline/data/processed/.gitkeep
ml-pipeline/data/splits/*
!ml-pipeline/data/splits/.gitkeep
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.h5
*.hdf5
*.parquet
*.feather

# ML Model Checkpoints & Weights
ml-pipeline/models/*
!ml-pipeline/models/.gitkeep
*.pt
*.pth
*.ckpt
*.bin
*.onnx
*.safetensors
*.joblib
*.pkl
*.pickle

# MATLAB & Simulink Autosave / Cache / Build artifacts
*.asv
*.m~
*.slxc
slprj/
*_mex*
*.mex*
*.autosave
*.mat
!simulink-model/data/*.mat
simulink-model/sim_output/*
!simulink-model/sim_output/.gitkeep

# Docker & Database local volumes
postgres_data/
redis_data/
*.log
backend/app/ml/quality/weights/*.pth
