# ==============================================================================
# Backend Environment Configuration Example
# Copy this file to .env and adjust variables for your local development setup
# ==============================================================================

PROJECT_NAME="Diabetic Retinopathy Screening API"
ENVIRONMENT=development
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="temporary-dev-secret-key-change-in-production"

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dr_user
POSTGRES_PASSWORD=dr_password
POSTGRES_DB=dr_screening
DATABASE_URL=postgresql+asyncpg://dr_user:dr_password@localhost:5432/dr_screening
SYNC_DATABASE_URL=postgresql://dr_user:dr_password@localhost:5432/dr_screening

# Redis Configuration (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ML Pipeline Service Configuration
ML_SERVICE_URL=http://localhost:8001
SIMULINK_SERVICE_URL=http://localhost:8002

# Tele-Ophthalmology & Alert Thresholds
REFERRAL_URGENCY_THRESHOLD=2
EXP_GRADCAM_OVERLAY=True

# ML Model Paths
MODEL_PATH=app/ml/weights/best_model.pth
MODEL_METADATA_PATH=app/ml/weights/model_metadata.json
